[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/Hud.cs" id="1_logica"]
[ext_resource type="Texture2D" path="res://assets/ui/corazon_lleno.png" id="2_lleno"]
[ext_resource type="Texture2D" path="res://assets/ui/corazon_medio.png" id="3_medio"]
[ext_resource type="Texture2D" path="res://assets/ui/corazon_vacio.png" id="4_vacio"]
[ext_resource type="Texture2D" path="res://assets/ui/icono_bomba.png" id="5_bomba"]
[ext_resource type="FontFile" path="res://assets/ui/fuente_hud.png" id="6_fuente"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_logica")
CorazonLleno = ExtResource("2_lleno")
CorazonMedio = ExtResource("3_medio")
CorazonVacio = ExtResource("4_vacio")

[node name="Raiz" type="Control" parent="."]
texture_filter = 1
layout_mode = 3
anchors_preset = 0
offset_left = 16.0
offset_top = 14.0
offset_right = 16.0
offset_bottom = 14.0
scale = Vector2(3, 3)
mouse_filter = 2

[node name="Columna" type="VBoxContainer" parent="Raiz"]
layout_mode = 0
mouse_filter = 2
theme_override_constants/separation = 3

[node name="Corazones" type="HBoxContainer" parent="Raiz/Columna"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 1

[node name="Bombas" type="HBoxContainer" parent="Raiz/Columna"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 1

[node name="Icono" type="TextureRect" parent="Raiz/Columna/Bombas"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
texture = ExtResource("5_bomba")

[node name="Texto" type="Label" parent="Raiz/Columna/Bombas"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("6_fuente")
theme_override_font_sizes/font_size = 12
text = "01"
